---
import Layout from "../layouts/Layout.astro";
import { lessons } from "../lib/lessons";

const query = Astro.url.searchParams.get("q") ?? "";
---

<Layout
  title="Teacher Toolkit"
  description="Search free, standards-aligned Everglades Literacy lessons for PreK–12 classrooms."
>
  <section class="mx-auto max-w-6xl px-6 py-12">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-water">Curriculum</p>
    <h1 id="toolkit-heading" class="mt-3 font-display text-4xl font-bold text-marsh">
      PreK–12 Teacher Toolkit
    </h1>
    <form id="lesson-search" action="/toolkit" method="get" class="mt-8 flex max-w-2xl flex-col gap-3 sm:flex-row">
      <label class="sr-only" for="q">Search lessons</label>
      <input
        id="q"
        name="q"
        type="search"
        value={query}
        placeholder="Search lessons"
        class="w-full rounded-lg border border-marsh/20 bg-white px-3 py-3"
      />
      <button
        type="submit"
        class="rounded-lg bg-sawgrass px-5 py-3 font-semibold text-white hover:bg-marsh"
      >
        Search
      </button>
    </form>

    <p id="search-status" class="mt-6 text-sm font-semibold text-marsh" role="status"></p>
    <ul id="search-results" class="mt-6 grid gap-5 md:grid-cols-2">
      {
        lessons.map((lesson) => (
          <li
            class="lesson-card rounded-2xl bg-white p-6 shadow-sm ring-1 ring-marsh/10"
            data-search={[lesson.title, lesson.grade, lesson.summary, ...lesson.tags].join(" ")}
          >
            <p class="text-sm font-semibold uppercase tracking-wide text-water">{lesson.grade}</p>
            <h2 class="mt-2 font-display text-2xl font-semibold text-marsh">{lesson.title}</h2>
            <p class="mt-3 text-ink/80">{lesson.summary}</p>
            <p class="mt-4 text-sm text-sawgrass">{lesson.tags.join(" · ")}</p>
          </li>
        ))
      }
    </ul>
    <p id="search-empty" class="mt-10 hidden rounded-xl bg-white p-6 ring-1 ring-marsh/10" role="status">
      No lessons matched that search. Try a grade level, animal, or habitat keyword.
    </p>
  </section>
</Layout>

<script>
  function applyLessonSearch() {
    const params = new URLSearchParams(window.location.search);
    const query = (params.get("q") ?? "").trim().toLowerCase();
    const cards = document.querySelectorAll<HTMLElement>(".lesson-card");
    const empty = document.getElementById("search-empty");
    const status = document.getElementById("search-status");
    const heading = document.getElementById("toolkit-heading");
    const input = document.getElementById("q");
    let visible = 0;

    if (input instanceof HTMLInputElement) {
      input.value = params.get("q") ?? "";
    }

    cards.forEach((card) => {
      const haystack = (card.dataset.search ?? "").toLowerCase();
      const matches = query.length === 0 || haystack.includes(query);
      card.classList.toggle("hidden", !matches);
      if (matches) visible += 1;
    });

    empty?.classList.toggle("hidden", visible !== 0);
    if (heading) {
      heading.textContent = query
        ? `Lessons matching “${params.get("q")?.trim()}”`
        : "PreK–12 Teacher Toolkit";
    }
    if (status) {
      status.textContent = query
        ? `${visible} lesson${visible === 1 ? "" : "s"} found`
        : `${cards.length} lessons in the toolkit`;
    }
  }

  applyLessonSearch();
  window.addEventListener("pageshow", applyLessonSearch);
</script>
