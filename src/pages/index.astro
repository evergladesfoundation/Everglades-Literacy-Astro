---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Everglades Literacy Program">
  <section class="bg-marsh text-sand">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-16 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sun">
          PreK–12 teacher program
        </p>
        <h1 class="mt-4 font-display text-4xl font-bold leading-tight md:text-6xl">
          Teach the Everglades. Grow the next generation of stewards.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-sand/90">
          The Everglades Literacy Program gives teachers free, standards-aligned lessons,
          professional development, and a Champion Schools path that puts restoration in the
          classroom.
        </p>
      </div>
      <form
        action="/toolkit"
        method="get"
        class="rounded-2xl bg-sand p-6 text-ink shadow-lg"
        aria-labelledby="lesson-search-heading"
      >
        <h2 id="lesson-search-heading" class="font-display text-2xl font-semibold text-marsh">
          Find a lesson
        </h2>
        <label for="q" class="mt-4 block text-sm font-semibold">
          Search by grade, topic, or keyword
        </label>
        <input
          id="q"
          name="q"
          type="search"
          placeholder="Try alligator, water, or 3rd grade"
          class="mt-2 w-full rounded-lg border border-marsh/20 bg-white px-3 py-3"
        />
        <button
          type="submit"
          class="mt-4 w-full rounded-lg bg-sawgrass px-4 py-3 font-semibold text-white hover:bg-marsh"
        >
          Search the toolkit
        </button>
      </form>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-6 py-16 md:grid-cols-3">
    <a class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-marsh/10 hover:ring-sawgrass" href="/toolkit">
      <h2 class="font-display text-2xl font-semibold text-marsh">Teacher Toolkit</h2>
      <p class="mt-3 text-ink/80">
        Explore free, interdisciplinary Everglades lessons aligned with Florida academic standards.
      </p>
    </a>
    <a class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-marsh/10 hover:ring-sawgrass" href="/champion-schools">
      <h2 class="font-display text-2xl font-semibold text-marsh">Champion Schools</h2>
      <p class="mt-3 text-ink/80">
        Recognize exceptional schoolwide literacy efforts and start an Intent to Apply.
      </p>
    </a>
    <a class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-marsh/10 hover:ring-sawgrass" href="/resources">
      <h2 class="font-display text-2xl font-semibold text-marsh">Instructional resources</h2>
      <p class="mt-3 text-ink/80">
        Bite-sized supplements for classroom, virtual, and family learning.
      </p>
    </a>
  </section>
</Layout>
